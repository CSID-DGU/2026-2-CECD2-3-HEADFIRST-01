# 이 파일을 복사해 같은 폴더에 .env를 만든다.

# 분류기 모드: mock(서버를 부르지 않고 정해진 답) / vllm(실제 분류기 호출)
CLASSIFIER_MODE=mock
# vllm 모드에서만 필요
VLLM_BASE_URL=http://<vLLM 서버 주소>:<포트>/v1
VLLM_MODEL=Qwen3.8-27B

# STT 엔진: stub / whisper_local(로컬 GPU Whisper)
STT_ENGINE=stub

# 이 서버를 부를 수 있는 프론트 주소(CORS). 여러 개면 쉼표로 구분
CORS_ORIGINS=http://localhost:5173,https://<프론트 Vercel 주소>
