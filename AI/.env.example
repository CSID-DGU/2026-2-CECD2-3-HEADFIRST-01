# AI 학습 환경 경로 설정
# 이 파일을 복사해 AI/.env를 만들고, 각 항목에 자기 환경의 절대 경로를 적는다.
#   cp AI/.env.example AI/.env
# AI/.env는 git에 올라가지 않는다 (레포 .gitignore).

# 모델 원본(Qwen3.8-27B, 약 55GB)을 내려받아 둘 폴더.
# 컨테이너 루트(ephemeral 50Gi 제한)는 피하고, 재시작해도 남는 곳(예: 홈/NAS 아래)으로 한다.
HF_HOME=

# 학습 환경(가상환경), 각종 캐시, 학습 중 결과를 둘 로컬 디스크 폴더.
# NAS는 작은 파일 쓰기가 매우 느리므로 노드 로컬 디스크(예: /var/tmp 아래)를 권장한다.
# Pod가 재시작되면 지워질 수 있다 → AI/train/setup_local_venv.sh로 다시 만든다.
LOCAL_ROOT=

# 학습이 끝난 결과(어댑터)를 옮겨 보관할 폴더. 재시작해도 남는 곳(예: 홈/NAS 아래).
RUNS_ARCHIVE=
