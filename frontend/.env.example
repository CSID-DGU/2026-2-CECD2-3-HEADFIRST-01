# 이 파일을 .env.local 로 복사해서 사용하세요. (.env.local 은 git에 올라가지 않음)

# true  : 백엔드 없이 가짜 응답(Mock)으로 동작  (기본값)
# false : 실제 백엔드 API 호출
VITE_USE_MOCK=true

# 실제 API 기본 주소. 비워두면 같은 origin의 /api 로 요청하고,
# 개발 서버(vite)가 아래 VITE_API_PROXY_TARGET 으로 전달합니다.
VITE_API_BASE_URL=

# 개발 서버 프록시 대상 (백엔드 주소)
VITE_API_PROXY_TARGET=http://localhost:8000

# 업로드 허용 최대 용량 (MB)
VITE_MAX_UPLOAD_MB=25
